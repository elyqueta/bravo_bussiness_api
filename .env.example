NODE_ENV=development
PORT=3000

# PostgreSQL - use a URL da Neon em desenvolvimento, ou a URL local do Docker
# Exemplo Neon:
# DATABASE_URL=postgresql://<USUARIO>:<PASSWORD>@<HOST>.neon.tech/<BANCO>?sslmode=require&channel_binding=require
# Exemplo local Docker:
# DATABASE_URL=postgres://bravo_user:bravo_password@localhost:5436/bravo_business
DATABASE_URL=

# CORS - ajuste para a porta do seu front
# Em produção, use o(s) domínio(s) exacto(s) do frontend separados por vírgula
# Ex: https://bravo-business.vercel.app,https://www.bravobusiness.co.ao
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Cookie do refresh token (produção)
# Domínio do cookie (ex: .bravobusiness.co.ao para partilhar entre subdomínios)
# Deixe vazio para cookies de mesma origem ou localhost
COOKIE_DOMAIN=

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT - mude esta chave para algo seguro e exclusivo
JWT_SECRET=bravo-business-api-super-secreta-com-pelo-menos-32-caracteres-aqui-mude-isso
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=604800000

# Security
BCRYPT_SALT_ROUNDS=12

# Cloudinary - obtenha em https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
