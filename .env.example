NODE_ENV=development
PORT=3000

# PostgreSQL local via Docker (porta 5436 mapeada para 5432)
DATABASE_URL=postgres://bravo_user:bravo_password@localhost:5436/bravo_business

# CORS - ajuste para a porta do seu front
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# JWT - mude esta chave para algo seguro e exclusivo
JWT_SECRET=bravo-business-api-super-secreta-com-pelo-menos-32-caracteres-aqui-mude-isso
JWT_ACCESS_EXPIRES_IN=15m

# Security
BCRYPT_SALT_ROUNDS=12

# Cloudinary - obtenha em https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
